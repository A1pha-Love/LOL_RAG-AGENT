# Copy to .env and fill in DASHSCOPE_API_KEY. .env is gitignored; this file is not.
#
# Every variable below is read somewhere in the code, and the value shown is the
# code's default — so an unset variable behaves exactly like the commented line.
# The only one that must be set is the API key.

# --- Required -----------------------------------------------------------------

# DashScope API key. Get it from the Alibaba Cloud console. Without it,
# lol_agent.config.require_api_key() raises on the first model call.
DASHSCOPE_API_KEY=

# --- Endpoint shape (usually leave unset) -------------------------------------

# Two host styles exist, and mixing them up is the most common setup failure:
#
#   generic (default)         https://dashscope.aliyuncs.com
#     Authenticates by API key alone. Nothing else is needed.
#
#   workspace-scoped          https://{workspace}.{region}.maas.aliyuncs.com
#     Requires the key to belong to that business space. A key from a different
#     space fails with "access_denied: Workspace endpoint access denied" even
#     though the key itself is valid.
#
# The generic host is the default deliberately: it keeps configuration to a
# single secret and avoids the mismatch above.
#
# Override the whole host (takes priority over the workspace settings):
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
#
# Opt back into a workspace-scoped host. Leave unset unless the key definitely
# belongs to this workspace.
# DASHSCOPE_WORKSPACE_ID=
# DASHSCOPE_REGION=cn-beijing

# --- Models -------------------------------------------------------------------

# Chat model: drives tool selection, the answer, and retrieval-query rewriting.
QWEN_CHAT_MODEL=qwen3.7-flash

# Sampling temperature. 0 is recommended: at the provider default, three evaluation
# cases were unstable — a guardrail case sometimes called a tool it must not, a
# timeline case sometimes claimed it could not answer although the section had been
# retrieved for it, and another case varied between runs. All three were stable across
# repeated runs at 0. For a data-analysis agent whose numbers users cross-check, giving
# a different answer to the same question is itself a defect.
# Delete this line (or set another value) to restore provider-default sampling; the
# evaluation harness accepts --temperature to measure a specific value without editing
# this file.
QWEN_TEMPERATURE=0

# Embedding model: 1024 dimensions. Changing it invalidates every stored vector,
# so scripts/index_knowledge.py must be re-run afterwards.
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding

# Cross-encoder reranker for the second retrieval stage.
QWEN_RERANK_MODEL=qwen3-rerank

# Set to 0 to skip reranking entirely and rank by embedding similarity alone.
# Useful for comparing stages, or when the rerank route is unavailable.
RERANK_ENABLED=1

# --- Local state --------------------------------------------------------------

# Session store location. Defaults to <project>/.cache/sessions.db.
# Keep it inside the project: the file sandbox denies writes elsewhere.
# SESSION_DB_PATH=
