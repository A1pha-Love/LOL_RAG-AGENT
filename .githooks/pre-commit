#!/bin/sh
# Pre-commit gate: run the fast offline checks before a commit is recorded.
#
# Installed by: git config core.hooksPath .githooks
# Bypass for a single commit with: git commit --no-verify
#
# Only the seconds-long checks run here (compile + unit tests). The slower
# offline checks are in scripts/run_checks.py, and anything that calls a model
# API is excluded on purpose: it costs quota and is not deterministic.

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

python_bin=".venv/Scripts/python.exe"
if [ ! -x "$python_bin" ]; then
    python_bin=$(command -v python3 || command -v python)
fi

if [ -z "$python_bin" ]; then
    echo "pre-commit: no Python interpreter found; skipping checks." >&2
    exit 0
fi

echo "pre-commit: 运行快速离线检查…"
if "$python_bin" scripts/run_checks.py --fast; then
    exit 0
fi

echo "" >&2
echo "pre-commit: 检查未通过，已阻止提交。" >&2
echo "  修复后重新提交，或用 git commit --no-verify 跳过本次检查。" >&2
exit 1
